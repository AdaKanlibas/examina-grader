# Examina Python Service — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

ENV=development

# Service auth (must match PYTHON_SERVICE_SECRET in Next.js .env.local)
SERVICE_SECRET=generate-a-random-secret-here

# Next.js app URL (for CORS)
NEXT_APP_URL=http://localhost:3000

# Mathpix (Phase 3)
MATHPIX_APP_ID=your-app-id
MATHPIX_APP_KEY=your-app-key

# ElevenLabs (Phase 4)
ELEVENLABS_API_KEY=your-key
ELEVENLABS_VOICE_ID_TR=your-turkish-voice-id
ELEVENLABS_VOICE_ID_EN=your-english-voice-id

# Supabase (for video cache uploads, Phase 4)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
