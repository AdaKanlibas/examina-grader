# ─── Examina — Environment Variables ──────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git — it is in .gitignore.

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_DOMAIN=examania.app
NEXT_PUBLIC_APP_URL=https://examania.app

# ── Supabase (EU region) ──────────────────────────────────────────────────────
# Get from: supabase.com → Project Settings → API
# SUPABASE_SERVICE_ROLE_KEY must be the JWT (eyJ...) format, not sb_secret_ format.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── OpenAI (embeddings only — text-embedding-3-small for pgvector retrieval) ──
OPENAI_API_KEY=your-openai-api-key

# ── Langfuse (LLM observability — grading cost & latency dashboard) ───────────
# Get from: cloud.langfuse.com → Project → Settings → API Keys
# Leave blank to disable tracing (grading still works without it).
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── Admin console ─────────────────────────────────────────────────────────────
# Protects /admin. Share /admin?k=VALUE with the reviewer for review queue access.
# Generate with: openssl rand -hex 32
ADMIN_SECRET=generate-a-random-secret-here

# ── Python service (Railway in production, localhost in dev) ──────────────────
# Not yet deployed — Phase 5 (SymPy verification, Manim video explanations).
PYTHON_SERVICE_URL=http://localhost:8000
PYTHON_SERVICE_SECRET=generate-a-random-secret-here

# ── Paddle (billing — Merchant of Record, handles EU VAT + Turkish KDV) ──────
# Phase 4 — integrate after auth is built.
# Paddle is used instead of Stripe because it requires no Turkish entity and
# handles KDV (Turkish VAT) automatically. Sign up at: paddle.com
PADDLE_API_KEY=pdl_live_...
PADDLE_WEBHOOK_SECRET=pdlwhk_...
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_...
NEXT_PUBLIC_PADDLE_ENV=sandbox

# ── Resend (transactional email — magic-link auth, receipts) ─────────────────
# Phase 4 — required for Supabase magic-link emails from examania.app domain.
RESEND_API_KEY=re_...

# ── Sentry (error monitoring) ─────────────────────────────────────────────────
# Not yet integrated — Phase 5 (production hardening).
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=...

# ── PostHog (product analytics — EU-hosted) ───────────────────────────────────
# Not yet integrated — Phase 5 (after auth, so events can be tied to users).
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
